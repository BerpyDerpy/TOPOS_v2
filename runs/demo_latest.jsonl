{"turn_index": 1, "timestamp": 1777553582.4152029, "autonomous_question_fired": false, "question_used": null, "input": "I burned my toast this morning. I do it every time I get distracted by my phone.", "epistemic_uncertainty": 0.003381323767825961, "prediction_error": 3.1586902141571045, "progress_signal": -1.3011645078659058, "top_5_concepts": ["time", "bread", "flour", "water", "salt"], "arousal": 0.38209137467124465, "valence": 0.0, "workspace_turn": 2, "threshold": 0.002913932406227104, "has_questions": false, "response_integrated": false, "domain": "everyday"}
